        "properties": {
          "integrity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "valid",
              "durable_grants_scanned",
              "delegated_grants_scanned",
              "violations"
            ],
            "properties": {
              "valid": {
                "type": "boolean"
              },
              "durable_grants_scanned": {
                "type": "integer",
                "minimum": 0
              },
              "delegated_grants_scanned": {
                "type": "integer",
                "minimum": 0
              },
              "violations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "store",
                    "grant_id",
                    "participant_id",
                    "detail"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string"
                    },
                    "store": {
                      "type": "string"
                    },
                    "grant_id": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    },
                    "participant_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 64
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "tags": [
        "blackboard",
        "authorization",
        "integrity",
        "privileged",
        "read"
      ],
      "tool_call_template": {
